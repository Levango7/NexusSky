# NexusSky gcs-web 前端镜像（多阶段构建）
# 构建：docker build -f deploy/docker/Dockerfile.web -t nexussky/gcs-web:0.1.0 .
# 上下文应为项目根目录。
#
# Vite 构建产物默认输出到 gcs-web/dist，由 Nginx 提供静态服务 + API/WS 反代。

# ===== 阶段 1：Node 构建 =====
FROM node:20-alpine AS builder
WORKDIR /build

# 先拷 lockfile 利用层缓存
COPY gcs-web/package.json gcs-web/package-lock.json* ./

# npm ci 要求 lockfile 存在且与 package.json 一致；否则回退 npm install
RUN npm ci || npm install

COPY gcs-web ./
RUN npm run build

# ===== 阶段 2：Nginx 运行时 =====
FROM nginx:alpine
# 反代上游缺省值：compose 服务名 / 原生 k8s Service 名都是 cloud-backend:8080；
# helm 部署时由 chart 注入 NS_BACKEND_HOST=<release>-cloud-backend 覆盖。
# nginx 官方镜像启动时对 /etc/nginx/templates/*.template 跑 envsubst 渲染到
# /etc/nginx/conf.d/，上游地址由此注入。
ENV NS_BACKEND_HOST=cloud-backend \
    NS_BACKEND_PORT=8080
# 移除默认配置；项目 nginx.conf 作为模板放入 templates 目录（启动时渲染）
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/templates/default.conf.template

# 创建 Nginx 运行所需目录并设置权限（非 Root 运行需要）
RUN mkdir -p /var/cache/nginx /run && chown -R nginx:nginx /var/cache/nginx /run /usr/share/nginx/html /etc/nginx/conf.d

# Nginx 镜像内置 nginx 用户，切换为非 Root 运行（安全加固）
USER nginx

# 非 root 无法绑定 80（特权端口），容器内监听 8080；对外端口由 Service / compose 映射
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1