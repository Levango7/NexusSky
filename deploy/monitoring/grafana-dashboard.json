          "expr": "sum(rate(http_server_requests_seconds_count{job=\"cloud-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"cloud-backend\"}[5m]))",
          "legendFormat": "5xx Error Rate",
          "refId": "A"
        }
      ]
    },
