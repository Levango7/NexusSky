# NexusSky 试用机环境文件模板
# 用法：deploy.sh 首次运行会自动用 openssl 生成随机值写出 .env（权限 600）；
# 手动部署时复制本文件为 .env 并逐项填写，不要提交 .env（已在 .gitignore）。

# ===== 镜像 =====
# 默认 latest（= CI 在 master 每次推送后发布的镜像）。
# 想钉死版本：改成与 master 提交短 sha 对应的 sha-xxxxxxx（tag 列表见
# https://github.com/Levango7/NexusSky/pkgs/container/nexussky%2Fcloud-backend）。
IMAGE_TAG=latest

# 宿主对外端口（默认 80；被占用时改这里，安全组同步放行）
WEB_PORT=80

# ===== 必填密钥（deploy.sh 自动生成；手动部署时自行填写）=====
# JWT 密钥：>=32 字符，两个变量同值即可
AEROFLEET_SECURITY_JWT_SECRET=
AEROFLEET_JWT_SECRET=
# 凭据加密密钥（AES-GCM，保护安防设备口令/webhook secret）：>=16 字符
AEROFLEET_ENCRYPTION_KEY=
# 管理端账号（无库降级路径）：username:password[:ROLE]
AEROFLEET_USERS=admin:CHANGE_ME:ADMIN
# prod（DB 模式）管理员口令的**唯一正路**：AdminBootstrapRunner 启动时创建/重置 ADMIN
# （库里种子 admin 已停用 V20）。须 >=8 字符；deploy.sh 会与上一行生成同一值。
AEROFLEET_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
# Postgres 密码（postgres 容器与后端数据源同源）
SPRING_DATASOURCE_PASSWORD=
# CORS 允许来源（经 nginx 同源反代时按需；填 http://<公网IP> 即可）
AEROFLEET_SECURITY_ALLOWED_ORIGINS=http://localhost

# ===== 可选 =====
# 设备/边缘上报共享 API Key（留空 = 摄取端点在 prod 下不可用，宁缺不滥发）
AEROFLEET_SECURITY_DEVICE_INGEST_API_KEY=
# MAVLink v2 链路签名（默认关；打开时 drone-sim 需配同一 key，见 README）
MAVLINK_SIGNING_ENABLED=false
MAVLINK_SIGNING_REJECT_UNSIGNED=true
MAVLINK_SIGNING_SECRET_KEY=
