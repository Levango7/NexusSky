<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.aerofleet</groupId>
  <artifactId>aerofleet-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AeroFleet</name>
  <description>无人机智能控制系统骨架：开源 MAVLink 协议栈 + 虚拟无人机模拟器 + 云端管理平台 + Web 地面站</description>

  <modules>
    <module>mavlink-core</module>
    <module>drone-sim</module>
    <module>link-sim</module>
    <module>cloud-backend</module>
    <module>sdk-java</module>
    <module>regulator-sim</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <junit.version>5.11.4</junit.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 安全覆写（2026-09-30，Security Scan/Trivy 门禁红因）：
           下列版本在 spring-boot-dependencies 3.5.16（当前最新 3.5.x）中低于
           Trivy 认定的修复版本，只能在这里钉。注意：import BOM 场景下用
           <properties> 覆写属性实测无效（探针：netty.version 改了仍解析
           4.1.135.Final），必须写直接条目；tomcat-embed-el/websocket 与 core
           版本强耦合，同版一起抬。
           依据：CVE-2026-65182/65905/68525（tomcat 10.1.59；10.1.58 已从
           Central 撤回，元数据里不存在）、CVE-2026-75595/59901（netty
           4.1.138.Final）、CVE-2026-54291（postgresql 42.7.13）、
           CVE-2026-68497（jackson-core/databind 2.21.7）。-->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>10.1.59</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>10.1.59</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>10.1.59</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-buffer</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-codec</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-common</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-handler</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-resolver</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-transport</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-transport-native-unix-common</artifactId>
        <version>4.1.138.Final</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.13</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.21.7</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.21.7</version>
      </dependency>
      <!-- 安全覆写第二批（2026-09-30 同日补，同一波 Security Scan 红因）：
           trivy-action v0.36.0 在 format=sarif 且未开 limit-severities-for-sarif 时
           会 unset TRIVY_SEVERITY（entrypoint.sh:76-83），severity 入参失效、
           exit-code 1 对**所有**严重级生效——第一批清掉 CRITICAL/HIGH 后，
           剩余 2 个 MEDIUM 仍红灯（SARIF 分析 7c755be：79 结果 → 4 结果，规则只剩这两条）。
           - log4j-api / log4j-to-slf4j 2.25.5：CVE-2026-49844（修复版 2.25.5/2.26.1），
             来自 spring-boot-starter-logging，两个 artifact 同版一起抬；
           - commons-lang3 3.18.0：CVE-2025-48924（修复版 3.18.0），
             来自 springdoc-openapi-starter-common 2.8.6 → swagger-core-jakarta 2.2.29。-->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>2.25.5</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-to-slf4j</artifactId>
        <version>2.25.5</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.18.0</version>
      </dependency>
      <dependency>
        <groupId>io.aerofleet</groupId>
        <artifactId>aerofleet-mavlink-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.aerofleet</groupId>
        <artifactId>aerofleet-drone-sim</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <!-- Spring 6 反射需要参数名（@PathVariable/@RequestParam 不写 name 也能工作） -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
